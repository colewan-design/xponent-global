APP_NAME="Xponent Global"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# 8010, not the more common 8000/8001, to avoid colliding with other local
# Laravel projects (php artisan serve defaults to 8000, and auto-falls back to
# 8001 if that's busy). Run with:
#   php artisan serve --port=8010
APP_URL=http://localhost:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite by default (zero config). To use the local XAMPP MySQL instead, comment
# DB_CONNECTION=sqlite out and uncomment/fill in the mysql block below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=xponent_global
# DB_USERNAME=root
# DB_PASSWORD=

# Admin (Vue) and public (Nuxt) app origins, used by config/cors.php and Sanctum.
# 3010, not Nuxt's default 3000, to avoid colliding with other local Nuxt apps.
FRONTEND_URL=http://localhost:3010
ADMIN_URL=http://localhost:5174
# Only the admin SPA authenticates via Sanctum's stateful/cookie session flow.
# The public Nuxt site must NOT be listed here — including it makes Sanctum
# require CSRF verification on every request from that origin, which breaks
# the public site's anonymous form POSTs (contact, newsletter, job applications).
SANCTUM_STATEFUL_DOMAINS=localhost:5174
SESSION_DOMAIN=localhost

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# New enquiries/applications are emailed here. With MAIL_MAILER=log, these
# just land in storage/logs/laravel.log — no external SMTP needed in dev.
ADMIN_NOTIFICATION_EMAIL=admin@xponent-global.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
